# ─────────────────────────────────────────────────────────────
#  Booking Pulse settings. GUIDE.md, step 4, explains each line.
#  This file stays on your computer. It is never uploaded to GitHub.
# ─────────────────────────────────────────────────────────────

# Supabase → your project → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → your avatar (top right) → Account preferences → Access Tokens → Generate new token
# → click "Create legacy token" (a normal token starts with no permissions)
SUPABASE_ACCESS_TOKEN=

# The database password you chose when you created the Supabase project
SUPABASE_DB_PASSWORD=

# The e-mail and password you want to use to sign in to your dashboard (pick any, min. 8 characters)
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=

# Given to you by the Muntra hosts at the event. Test environment only.
MUNTRA_API_BASE_URL=
MUNTRA_API_TOKEN=

# Leave empty. Setup fills this in for you.
MUNTRA_WEBHOOK_SECRET=
